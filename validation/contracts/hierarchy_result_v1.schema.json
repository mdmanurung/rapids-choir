{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "node_id": {
      "pattern": "^[0-9]+$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate": {
      "additionalProperties": false,
      "properties": {
        "attempt": {"minimum": 1, "type": "integer"},
        "commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_tree_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["commit", "attempt", "runtime_tree_sha256", "manifest_sha256"],
      "type": "object"
    },
    "cell_ids": {
      "items": {"minLength": 1, "type": "string"},
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "dataset_id": {"minLength": 1, "type": "string"},
    "labels": {
      "items": {"type": ["integer", "string"]},
      "minItems": 1,
      "type": "array"
    },
    "provenance": {
      "properties": {
        "configuration": {"type": "object"},
        "input_contract": {"type": "object"},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "multiplicity": {"enum": ["none", "bonferroni", "bh"]},
        "random_state": {"type": "integer"},
        "rules": {"enum": ["choir_v0_3_0", "corrected"]},
        "run_id": {"pattern": "^run-[0-9a-f]{32}$", "type": "string"},
        "schema": {"const": "rapids_choir.result/v1"}
      },
      "required": [
        "schema",
        "run_id",
        "input_sha256",
        "input_contract",
        "configuration",
        "rules",
        "multiplicity",
        "random_state"
      ],
      "type": "object"
    },
    "run_id": {"pattern": "^run-[0-9a-f]{32}$", "type": "string"},
    "schema_version": {"const": "rapids_choir.hierarchy-result/v1"},
    "semantic_trace": {
      "additionalProperties": false,
      "properties": {
        "event_schema": {"const": "rapids_choir.semantic/v1"},
        "format": {"enum": ["jsonl", "parquet_manifest"]},
        "path": {"minLength": 1, "type": "string"},
        "row_count": {"minimum": 1, "type": "integer"},
        "run_id": {"pattern": "^run-[0-9a-f]{32}$", "type": "string"},
        "schema_version": {"const": "rapids_choir.semantic-artifact/v1"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": [
        "schema_version",
        "format",
        "path",
        "sha256",
        "row_count",
        "run_id",
        "event_schema"
      ],
      "type": "object"
    },
    "tree": {
      "additionalProperties": false,
      "properties": {
        "assignments": {
          "items": {
            "items": {"$ref": "#/$defs/node_id"},
            "minItems": 1,
            "type": "array"
          },
          "minItems": 1,
          "type": "array"
        },
        "cell_ids": {
          "items": {"minLength": 1, "type": "string"},
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "nodes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "child_ids": {
                "items": {"$ref": "#/$defs/node_id"},
                "type": "array",
                "uniqueItems": true
              },
              "label": {"minLength": 1, "type": "string"},
              "level": {"minimum": 1, "type": "integer"},
              "membership_sha256": {"$ref": "#/$defs/sha256"},
              "node_id": {"$ref": "#/$defs/node_id"},
              "ordinal": {"minimum": 1, "type": "integer"},
              "parent_id": {
                "anyOf": [
                  {"$ref": "#/$defs/node_id"},
                  {"type": "null"}
                ]
              },
              "size": {"minimum": 1, "type": "integer"}
            },
            "required": [
              "node_id",
              "label",
              "level",
              "ordinal",
              "size",
              "membership_sha256",
              "parent_id",
              "child_ids"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "resolutions": {
          "items": {"type": ["number", "null"]},
          "minItems": 1,
          "type": "array"
        },
        "root_id": {"$ref": "#/$defs/node_id"},
        "schema": {"const": "rapids_choir.hierarchy/v1"}
      },
      "required": [
        "schema",
        "cell_ids",
        "assignments",
        "nodes",
        "resolutions",
        "root_id"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "candidate",
    "dataset_id",
    "run_id",
    "cell_ids",
    "labels",
    "tree",
    "provenance",
    "semantic_trace"
  ],
  "title": "rapids-choir hierarchy result v1",
  "type": "object"
}
